{% set loaded = git is defined %}
{% set project = loaded ? git.project : snapshot.project|default(null) %}
<div id="git-panel" class="review-panel" data-console-component="git" data-component-url="{{ path('app_console_git', {project:project}) }}" data-project-id="{{ project }}" data-review-loaded="{{ loaded ? 'true' : 'false' }}" data-commit-base="{{ path('app_console_git') }}/commits/">
    <div class="panel-heading"><div><h2>Git provenance</h2><p class="muted">Observed repository history and self-reported task correlations.</p></div><button type="button" data-review-refresh>Refresh Git</button></div>
    <p data-review-error role="alert" class="notice danger" hidden></p><p data-review-status role="status" class="muted">{{ loaded ? 'Authoritative indexed data · up to 25 activities and 50 graph nodes' : 'Open Git to load indexed history.' }}</p>
    {% if loaded %}
    <form class="review-filters" data-review-form action="{{ path('app_console_git') }}" method="get">
        <input type="hidden" name="project" value="{{ project }}"><input type="hidden" name="page" value="{{ git.page }}">
        <label for="git-repository">Repository<select id="git-repository" name="repository"><option value="">Select repository</option>{% for repository in git.repositories %}<option value="{{ repository.id }}" {{ git.repository and repository.id == git.repository.id ? 'selected' : '' }}>Repository …{{ repository.id|slice(-8) }}</option>{% endfor %}</select></label>
        <label for="git-branch">Observed ref<select id="git-branch" name="branch"><option value="">All observed history</option>{% for ref, sha in git.repository.refs|default({}) %}<option value="{{ ref }}" {{ git.filter.branch == ref ? 'selected' : '' }}>{{ ref }}</option>{% endfor %}</select></label>
        <label for="git-search">Search commits / refs<input id="git-search" name="q" type="search" maxlength="160" value="{{ git.filter.q }}" placeholder="SHA, message, author or ref"></label>
        <label for="git-activity">Activity<select id="git-activity" name="activity">{% for key,label in {all:'All activity',commit:'Commits',merge:'Merges',ref:'Ref observations'} %}<option value="{{ key }}" {{ git.filter.activity == key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><button>Apply filters</button>
    </form>
    {% if git.repository %}<p class="scope-note">Repository <code>{{ git.repository.id }}</code> · last observed {{ git.repository.observed_at|default('not yet', true) }} UTC. Ref observations do not record exact creation/deletion time.</p>{% endif %}
    <section class="git-graph-panel" aria-labelledby="git-graph-title"><div class="panel-heading"><h3 id="git-graph-title">Branch ancestry tree</h3><div class="git-graph-controls" role="group" aria-label="Graph controls"><button type="button" data-graph-zoom="in" aria-label="Zoom graph in">+</button><button type="button" data-graph-zoom="out" aria-label="Zoom graph out">−</button><button type="button" data-graph-readable>Readable view</button><button type="button" data-graph-fit>Fit graph</button></div></div>
        <p class="muted">Older commits at the top; branches split and merges join along recorded parent links. Choose a ref to trace its ancestry. Ref names do not verify agent ownership.</p>
        <div class="git-branch-list" role="group" aria-label="Observed branch tips">{% for branch in git.branches %}<button type="button" data-graph-ref="{{ branch.sha }}" aria-pressed="false" {{ not branch.visible ? 'disabled' : '' }} title="{{ branch.ref }} · {{ branch.sha }}{{ not branch.visible ? ' · outside current graph; select this ref in filters' : '' }}">{{ branch.ref|replace({'refs/heads/':'', 'refs/remotes/':'', 'refs/tags/':'tag: '}) }}</button>{% endfor %}<button type="button" data-graph-clear>Clear trace</button></div>
        <p class="muted" data-graph-trace-status role="status">Up to {{ git.graph_limit }} displayed commits from {{ git.candidate_count }} indexed candidates (read capped at 500). Dashed links label collapsed commits; boundary markers mean earlier parents are outside this view.</p>
        <div class="git-graph-viewport" data-review-scroll="graph" tabindex="0" aria-label="Commit tree pan area">
        {% if git.graph.nodes is not empty %}<svg data-git-graph data-graph-width="{{ git.graph.width }}" data-graph-height="{{ git.graph.height }}" viewBox="0 0 {{ git.graph.width }} {{ min(git.graph.height, 560) }}" preserveAspectRatio="xMidYMin meet" role="group" aria-label="Indexed branch ancestry tree">
            {% for edge in git.graph.edges %}{% set from = git.graph.nodes[edge.from] %}{% set to = git.graph.nodes[edge.to] %}{% set middle = (from.y + to.y) / 2 %}<g data-graph-edge data-from="{{ edge.from|slice(1) }}" data-to="{{ edge.to|slice(1) }}"><path d="M {{ from.x }} {{ from.y + 28 }} C {{ from.x }} {{ middle }}, {{ to.x }} {{ middle }}, {{ to.x }} {{ to.y - 28 }}" fill="none" stroke="currentColor" stroke-width="2" {% if edge.skipped %}stroke-dasharray="5 4"{% endif %}><title>{{ edge.skipped ? edge.skipped ~ ' intermediate commits collapsed' : 'Recorded parent relationship' }}</title></path>{% if edge.skipped %}<text x="{{ (from.x + to.x) / 2 + 8 }}" y="{{ middle }}" class="git-edge-count">+{{ edge.skipped }}</text>{% endif %}</g>{% endfor %}
            {% for id,node in git.graph.nodes %}{% set sha = id|slice(1) %}<a href="{{ path('app_console_git_commit', {sha:sha, project:project, repository:git.repository.id}) }}" data-git-commit="{{ sha }}" data-graph-x="{{ node.x }}" data-graph-y="{{ node.y }}" aria-label="Inspect commit {{ node.label }}: {{ node.subject }}"><title>{{ node.label }} · {{ node.subject }}{% for ref in node.refs %} · {{ ref }}{% endfor %}{{ node.boundary ? ' · earlier parents outside view' : '' }}</title><rect x="{{ node.x - 98 }}" y="{{ node.y - 28 }}" width="196" height="56" rx="7" class="{{ node.refs ? 'git-ref-tip' : '' }}"/><text x="{{ node.x }}" y="{{ node.y - 5 }}" text-anchor="middle">{{ node.label }}{{ node.refs ? ' ●' : '' }}</text><text x="{{ node.x }}" y="{{ node.y + 15 }}" text-anchor="middle" class="git-node-subject">{{ node.subject|length > 25 ? node.subject|slice(0,24) ~ '…' : node.subject }}</text>{% if node.boundary %}<text x="{{ node.x }}" y="{{ node.y - 36 }}" text-anchor="middle" class="git-boundary">↑ earlier history outside view</text>{% endif %}</a>{% endfor %}
        </svg>{% else %}<p class="empty-state">No indexed commits match these filters.</p>{% endif %}</div>
        <details data-review-detail="mermaid"><summary>Mermaid source</summary><pre>{{ git.mermaid }}</pre></details>
    </section>
    <section data-git-selection hidden aria-label="Selected commit"><div class="panel-heading"><h3 tabindex="-1" id="git-selected-heading">Selected commit</h3><button type="button" data-git-close>Close commit</button></div><div data-git-selected-content></div></section>
    <section aria-labelledby="git-timeline-title"><h3 id="git-timeline-title">Activity timeline</h3><ol class="git-timeline" data-review-scroll="timeline">{% for event in git.events %}<li data-entity-type="git_event" data-entity-id="{{ event.id }}"><details data-review-detail="event-{{ event.id }}"><summary><span class="status">{{ event.kind|replace({'_':' '}) }}</span><strong>{{ event.message ? event.message|split('\n')|first|slice(0,160) : event.ref|default('Ref observation', true) }}</strong><code>{{ event.sha|default('deleted', true)|slice(0,12) }}</code><time datetime="{{ event.observed_at|date('c', 'UTC') }}">{{ event.observed_at }} UTC</time></summary>{% if event.kind in ['commit','merge'] %}{% include 'observability/_git_commit.html.twig' with {event:event,project:project} only %}{% else %}<dl class="git-facts"><div><dt>Ref</dt><dd>{{ event.ref }}</dd></div><div><dt>Before</dt><dd><code>{{ event.old_ref|default('not observed', true) }}</code></dd></div><div><dt>After</dt><dd><code>{{ event.new_ref|default('deleted', true) }}</code></dd></div></dl>{% endif %}</details></li>{% else %}<li class="empty-state">{{ git.repositories is empty ? 'No repositories registered for this project.' : 'No indexed activity matches these filters.' }}</li>{% endfor %}</ol></section>
    <nav class="pagination" aria-label="Git activity pages"><button type="button" data-review-page="{{ git.page - 1 }}" {{ git.page == 0 ? 'disabled' : '' }}>Previous</button><span>Page {{ git.page + 1 }} · up to {{ git.page_size }} activities</span><button type="button" data-review-page="{{ git.page + 1 }}" {{ not git.has_next ? 'disabled' : '' }}>Next</button></nav>
    {% else %}<p class="empty-state">Git evidence loads when this view opens. <a href="{{ path('app_console_git', {project:project}) }}">Open indexed Git history</a></p>{% endif %}
</div>

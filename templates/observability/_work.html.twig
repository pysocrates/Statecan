{% import 'observability/_components.html.twig' as ui %}
{% set ops = snapshot.operations %}
<div data-console-component="work" data-component-url="{{ path('app_dashboard') }}/components/work?{{ {project:snapshot.project,page:snapshot.page}|url_encode }}">
    <div class="section-intro"><p>All backend states, grouped for supervision. Original status badges retain their meaning.</p><span class="muted">Page {{ snapshot.page + 1 }} · up to {{ snapshot.page_size }} tasks</span></div>
    <div class="board" aria-label="Kanban">
        {% for key, label in {ready:'Ready', progress:'In progress', attention:'Attention', done:'Done'} %}
        <section class="column column-{{ key }}" aria-labelledby="column-{{ key }}"><div class="column-heading"><h2 id="column-{{ key }}">{{ label }}</h2><span class="count" title="Project-wide total">{{ ops.group_counts[key] }}</span></div>
            <p class="column-description">{{ {ready:'Backlog and ready; only ready tasks can be claimed.', progress:'Claimed, running, or waiting for evidence.', attention:'Blocked, failed, or waiting for human review.', done:'Completed or cancelled; original status retained.'}[key] }}</p>
            <div id="work-column-{{ key }}-tasks" class="column-tasks" tabindex="0" aria-label="{{ label }} tasks">
            {% for task in snapshot.work_groups[key] %}<article class="task-card" data-entity-type="task" data-entity-id="{{ task.id }}"><span class="status status-{{ task.status }}">{{ task.status|replace({'_':' '}) }}</span><h3><a title="{{ task.title }}" href="{{ path('app_dashboard', {project:snapshot.project, task:task.id, page:snapshot.page}) }}#work">{{ task.title }}</a></h3><p class="task-agent">{{ task.agent|default('Unassigned') }}</p><footer><small>v{{ task.version }} · contract {{ task.contract_version }}</small>{% if task.lease_expired and task.status in ['claimed','running','blocked','awaiting_review'] %}<span class="warning-text">Lease expired</span>{% elseif task.status == 'completion_pending_evidence' %}<span class="muted">Evidence pending</span>{% endif %}</footer></article>{% else %}<p class="empty-state">No {{ label|lower }} tasks on this page.</p>{% endfor %}
            </div>
        </section>{% endfor %}
    </div>
    <nav class="pagination" aria-label="Work pages">{% if snapshot.page > 0 %}<a href="{{ path('app_dashboard', {project:snapshot.project, task:snapshot.task.id|default(null), page:snapshot.page - 1}) }}#work">← Previous</a>{% endif %}<span>Page {{ snapshot.page + 1 }}</span>{% if snapshot.has_next %}<a href="{{ path('app_dashboard', {project:snapshot.project, task:snapshot.task.id|default(null), page:snapshot.page + 1}) }}#work">Next →</a>{% endif %}</nav>
</div>

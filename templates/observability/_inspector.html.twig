{% if inspector is not defined or inspector is null %}
<aside id="task-inspector" class="task-inspector" aria-label="Task inspector" hidden data-endpoint-template="{{ path('app_task_inspector', {id:'__TASK__'}) }}" data-task-id="" data-dashboard-url="{{ path('app_dashboard') }}" data-login-url="{{ path('app_login') }}">
    <div class="inspector-toolbar"><span class="eyebrow">TASK INSPECTOR</span><button type="button" id="inspector-close" aria-label="Close task inspector">Close ×</button></div>
    <p id="inspector-loading" role="status" hidden>Loading task…</p>
    <div id="inspector-error" class="notice danger" role="alert" hidden></div>
    <button type="button" id="inspector-retry" hidden>Retry task details</button>
    <div id="inspector-content"></div>
</aside>
{% else %}
{% set task = inspector.task %}
{% set contract = inspector.contract.document %}
<header class="inspector-heading" data-session-id="{{ inspector.lease.session_id|default('') }}" data-agent-id="{{ inspector.lease.agent_id|default('') }}"><div class="inspector-project">{{ task.project_name }}</div><h2 id="inspector-title" tabindex="-1">{{ task.title }}</h2><span class="status status-{{ task.status }}">{{ task.status|replace({'_':' '}) }}</span><span class="muted">Task v{{ task.version }} · contract v{{ task.contract_version }}</span><p class="inspector-id">{{ task.id }}</p></header>
<dl class="inspector-facts"><div><dt>Created</dt><dd>{{ task.created_at|date('M j, H:i:s', 'UTC') }} UTC</dd></div><div><dt>Updated</dt><dd>{{ task.updated_at|date('M j, H:i:s', 'UTC') }} UTC</dd></div></dl>
{% if task.status == 'completion_pending_evidence' %}<p class="notice">Completion is pending evidence. This task is not finalized.</p>{% elseif task.status == 'cancelled' %}<p class="notice">Cancelled is a terminal state, not a successful completion.</p>{% endif %}
<details data-inspector-section="contract" open><summary id="inspector-section-contract">Contract & requirements</summary>
    <label for="inspector-contract-version">Inspect contract version</label><select id="inspector-contract-version" data-inspector-contract><option value="{{ inspector.contract.version }}" selected>v{{ inspector.contract.version }}{{ inspector.contract.version == task.contract_version ? ' · current' : ' · historical' }}</option>{% for version in inspector.contracts %}{% if version.version != inspector.contract.version %}<option value="{{ version.version }}">v{{ version.version }} · {{ version.created_at|date('M j H:i', 'UTC') }}</option>{% endif %}{% endfor %}</select>
    <h3>Objective</h3><p>{{ contract.objective }}</p>
    {% for field, label in {authorizedScope:'Authorized scope', constraints:'Constraints', acceptanceCriteria:'Acceptance criteria', expectedDeliverables:'Expected deliverables'} %}<h3>{{ label }}</h3><ul class="inspector-requirements">{% for item in attribute(contract, field)|default([]) %}<li>{{ item }}</li>{% else %}<li class="muted">None specified.</li>{% endfor %}</ul>{% endfor %}
    {% if contract.resourceBudgets|default([]) is not empty %}<h3>Resource budgets</h3><dl class="inspector-facts">{% for name, value in contract.resourceBudgets %}<div><dt>{{ name }}</dt><dd>{{ value }}</dd></div>{% endfor %}</dl>{% endif %}
    <details data-inspector-section="raw-contract"><summary id="inspector-section-raw-contract">Raw contract JSON · v{{ inspector.contract.version }}</summary><pre>{{ contract|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>
</details>
<details data-inspector-section="dependencies"><summary id="inspector-section-dependencies">Dependencies · {{ inspector.dependencies|length }}{{ inspector.has_next.dependencies ? '+' : '' }}</summary>
    <p class="muted">Current relational dependencies. Historical requirements remain in their contract version.</p><ul class="inspector-records">{% for dependency in inspector.dependencies %}<li><small>{{ dependency.direction == 'requires' ? 'Requires' : 'Required by' }}</small><a href="{{ path('app_dashboard', {project:task.project_id,task:dependency.id}) }}" data-inspect-task="{{ dependency.id }}" data-project-id="{{ task.project_id }}" data-related-task="{{ dependency.id }}">{{ dependency.title }}</a><span class="status status-{{ dependency.status }}">{{ dependency.status|replace({'_':' '}) }}</span></li>{% else %}<li class="muted">No dependency relationships on this page.</li>{% endfor %}</ul>
</details>
<details data-inspector-section="ownership" open><summary id="inspector-section-ownership">Agent, session & lease</summary>
{% if inspector.lease %}{% set lease = inspector.lease %}<dl class="inspector-facts"><div><dt>Agent</dt><dd>{{ lease.agent_name }}</dd></div><div><dt>Session</dt><dd class="inspector-id">{{ lease.session_id }}</dd></div><div><dt>Session heartbeat</dt><dd>{{ lease.last_heartbeat_at|date('M j H:i:s', 'UTC') }} UTC · {{ lease.session_fresh ? 'fresh (≤5m)' : 'stale (>5m)' }}</dd></div><div><dt>Lease</dt><dd>{{ lease.active ? 'Active' : 'Expired' }} · generation {{ lease.generation }}</dd></div><div><dt>Expires</dt><dd>{{ lease.expires_at|date('M j H:i:s', 'UTC') }} UTC</dd></div></dl><p class="muted">Lease state controls Statecan permissions. It does not lock external Git files. A heartbeat does not prove progress.</p>{% else %}<p class="empty-state">No lease or responsible session has been recorded for this task.</p>{% endif %}
</details>
<details data-inspector-section="history" open><summary id="inspector-section-history">Transition history · {{ inspector.events|length }}{{ inspector.has_next.events ? '+' : '' }}</summary><ol class="inspector-records inspector-timeline">{% for event in inspector.events %}<li><strong>{{ event.from_state ? event.from_state|replace({'_':' '}) ~ ' → ' : '' }}{{ event.to_state|replace({'_':' '}) }}</strong><small>v{{ event.version }} · {{ event.created_at|date('M j H:i:s', 'UTC') }} UTC</small><span class="inspector-id">{{ event.actor_id }}</span></li>{% else %}<li class="empty-state">No recorded transitions on this page.</li>{% endfor %}</ol></details>
<details data-inspector-section="git"><summary id="inspector-section-git">Git provenance · {{ inspector.git|length }}{{ inspector.has_next.git ? '+' : '' }}</summary><p class="muted">Trailers are self-reported. Identity validation does not establish authorship or prove work was performed.</p><ul class="inspector-records">{% for association in inspector.git %}<li><strong>{{ association.subject|default('Indexed commit association', true) }}</strong><code>{{ association.sha }}</code><dl class="inspector-facts"><div><dt>Identity validation</dt><dd>{{ association.verification_status }}</dd></div><div><dt>Source / confidence</dt><dd>{{ association.source }} / {{ association.confidence }}</dd></div><div><dt>Observed</dt><dd>{{ association.observed_at|date('M j H:i:s', 'UTC') }} UTC</dd></div>{% if association.session_id %}<div><dt>Reported session</dt><dd class="inspector-id">{{ association.session_id }}</dd></div>{% endif %}</dl></li>{% else %}<li class="empty-state">No indexed task-to-commit associations on this page.</li>{% endfor %}</ul></details>
<details data-inspector-section="receipts"><summary id="inspector-section-receipts">Completion evidence · {{ inspector.receipts|length }}{{ inspector.has_next.receipts ? '+' : '' }}</summary><p class="muted">Pending attempts and verified receipts are distinct. Hashes verify integrity; storage policy provides immutability.</p><ul class="inspector-records">{% for receipt in inspector.receipts %}<li><strong>{{ receipt.status|capitalize }}</strong><small>Contract v{{ receipt.contract_version }} · lease generation {{ receipt.lease_generation }} · {{ receipt.created_at|date('M j H:i:s', 'UTC') }} UTC</small><span class="inspector-id">{{ receipt.id }}</span>{% if receipt.hash %}<dl class="inspector-facts"><div><dt>Recorded SHA-256</dt><dd><code>{{ receipt.hash }}</code></dd></div></dl>{% endif %}<a href="{{ path('api_observability_receipt', {id:receipt.id}) }}" target="_blank" rel="noopener">Inspect canonical evidence JSON<span class="sr-only"> (new tab)</span> ↗</a></li>{% else %}<li class="empty-state">No completion evidence on this page.</li>{% endfor %}</ul></details>
{% set failures = inspector.jobs|filter(job => job.error or job.status == 'failed') %}
<details data-inspector-section="errors" {{ failures is not empty ? 'open' : '' }}><summary id="inspector-section-errors">Related processing · {{ inspector.jobs|length }}{{ inspector.has_next.jobs ? '+' : '' }} jobs</summary><ul class="inspector-records">{% for job in inspector.jobs %}<li><strong>{{ job.status|capitalize }} · {{ job.attempts }} attempt{{ job.attempts == 1 ? '' : 's' }}</strong><small>{{ job.message_type }}</small>{% if job.error %}<pre class="inspector-error-detail">{{ job.error }}</pre>{% endif %}<span class="inspector-id">{{ job.id }}</span></li>{% else %}<li class="empty-state">No related job records on this page. This is not a guarantee that no external errors occurred.</li>{% endfor %}</ul></details>
<nav id="inspector-pagination" tabindex="-1" class="inspector-pagination" aria-label="Task inspector history pages">{% if inspector.page > 0 %}<button type="button" id="inspector-previous-page" data-inspector-page="{{ inspector.page - 1 }}">← Previous records</button>{% endif %}<span>Page {{ inspector.page + 1 }} · up to {{ inspector.page_size }} per section</span>{% if true in inspector.has_next %}<button type="button" id="inspector-next-page" data-inspector-page="{{ inspector.page + 1 }}">Next records →</button>{% endif %}</nav>
<p class="inspector-observed muted">Read {{ inspector.observed_at|date('H:i:s', 'UTC') }} UTC · <a href="{{ path('api_task_inspector', {id:task.id,project:task.project_id,page:inspector.page}) }}" target="_blank" rel="noopener">Structured JSON ↗</a></p>
{% endif %}

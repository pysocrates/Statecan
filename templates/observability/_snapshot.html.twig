{% import 'observability/_components.html.twig' as ui %}
{% set ops = snapshot.operations %}
{% set initial = snapshot.task ? 'work' : 'operations' %}
{% include 'observability/_projects.html.twig' %}
<section id="view-operations" data-console-view="operations" aria-label="Operations" {{ initial != 'operations' ? 'hidden' : '' }}>
{% include 'observability/_operations.html.twig' %}
</section>
<section id="view-work" data-console-view="work" aria-label="Work" {{ initial != 'work' ? 'hidden' : '' }}>
{% include 'observability/_work.html.twig' %}
</section>
<section id="view-git" data-console-view="git" aria-label="Git" hidden>
{% include 'observability/_git.html.twig' %}
</section>
<section id="view-history" data-console-view="history" aria-label="History" hidden>
{% include 'observability/_history.html.twig' %}
</section>
<section id="view-runtime" data-console-view="runtime" aria-label="Runtime" hidden>
{% include 'observability/_runtime.html.twig' %}
</section>

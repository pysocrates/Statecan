{% set loaded = history is defined %}
{% set project = loaded ? history.project : snapshot.project|default(null) %}
<div id="history-panel" class="review-panel" data-console-component="history" data-component-url="{{ path('app_console_history', {project:project}) }}" data-project-id="{{ project }}" data-review-loaded="{{ loaded ? 'true' : 'false' }}">
    <div class="panel-heading"><div><h2>Historical review</h2><p class="muted">Persisted transitions, sessions, evidence, contract versions and Git correlations.</p></div><button type="button" data-review-refresh>Refresh history</button></div>
    <p data-review-error role="alert" class="notice danger" hidden></p><p data-review-status role="status" class="muted">{{ loaded ? 'Authoritative records · UTC · 25 per page' : 'Open History to load recorded activity.' }}</p>
    {% if loaded %}
    <form class="review-filters" data-review-form action="{{ path('app_console_history') }}" method="get">
        <input type="hidden" name="project" value="{{ project }}"><input type="hidden" name="page" value="{{ history.page }}">
        <label for="history-kind">Record type<select id="history-kind" name="kind">{% for key,label in {transitions:'Task transitions',sessions:'Session / task activity',receipts:'Completion receipts',contracts:'Contract versions',git:'Git correlations'} %}<option value="{{ key }}" {{ history.kind == key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
        <label for="history-search">Search records<input id="history-search" name="q" type="search" maxlength="160" value="{{ history.filter.q }}" placeholder="Task, identity or evidence reference"></label>
        <label for="history-task">Task ID<input id="history-task" name="task" value="{{ history.filter.task }}" maxlength="36" placeholder="Optional task UUID"></label>
        <label for="history-status">Recorded status<select id="history-status" name="status"><option value="">All statuses</option>{% for status in history.statuses %}<option value="{{ status }}" {{ history.filter.status == status ? 'selected' : '' }}>{{ status|replace({'_':' '}) }}</option>{% endfor %}</select></label><button>Apply filters</button>
    </form>
    <ol class="history-records" data-review-scroll="records">{% for row in history.rows %}
        <li data-entity-type="{{ {transitions:'state_event',sessions:'agent_session',receipts:'completion_receipt',contracts:'task_contract',git:'git_task_association'}[history.kind] }}" data-entity-id="{{ row.id }}"><details data-review-detail="history-{{ history.kind }}-{{ row.id }}-{{ row.task_id }}"><summary><span class="status status-{{ row.status }}">{{ row.status|replace({'_':' '}) }}</span><strong>{{ row.title }}</strong><time datetime="{{ row.occurred_at|date('c', 'UTC') }}">{{ row.occurred_at }} UTC</time></summary>
            <div class="history-detail"><p><a data-inspect-task="{{ row.task_id }}" data-project-id="{{ project }}" href="{{ path('app_dashboard', {project:project,task:row.task_id}) }}#history">Inspect task</a> <code>{{ row.task_id }}</code></p>
            <dl class="git-facts">
            {% if history.kind == 'transitions' %}<div><dt>Transition</dt><dd>{{ row.from_state|default('Initial', true)|replace({'_':' '}) }} → {{ row.status|replace({'_':' '}) }}</dd></div><div><dt>Task version</dt><dd>{{ row.version }}</dd></div><div><dt>Recorded actor</dt><dd><code>{{ row.actor_id }}</code></dd></div>
            {% elseif history.kind == 'sessions' %}<div><dt>Agent</dt><dd>{{ row.agent }}</dd></div><div><dt>Session</dt><dd><code>{{ row.session_id }}</code></dd></div><div><dt>Last recorded heartbeat (UTC)</dt><dd>{{ row.last_heartbeat_at }}</dd></div><div><dt>Scope</dt><dd>Historical session / task relationship; not a claim of current activity.</dd></div>
            {% elseif history.kind == 'receipts' %}<div><dt>Receipt</dt><dd><code>{{ row.id }}</code></dd></div><div><dt>Contract version</dt><dd>{{ row.contract_version }}</dd></div><div><dt>Lease generation</dt><dd>{{ row.lease_generation }}</dd></div><div><dt>SHA-256</dt><dd><code>{{ row.hash|default('Not finalized', true) }}</code></dd></div>
            {% elseif history.kind == 'contracts' %}<div><dt>Contract version</dt><dd>{{ row.version }}</dd></div><div><dt>Objective</dt><dd>{{ row.document.objective|default('Not specified') }}</dd></div>
            {% elseif history.kind == 'git' %}<div><dt>Commit</dt><dd><code>{{ row.sha }}</code></dd></div><div><dt>Repository</dt><dd><code>{{ row.repository_id }}</code></dd></div><div><dt>Source</dt><dd>{{ row.source }}</dd></div><div><dt>Confidence</dt><dd>{{ row.confidence|replace({'_':' '}) }} · does not authenticate authorship</dd></div>{% endif %}
            {% if row.session_id|default(null) and history.kind != 'sessions' %}<div><dt>Session reference</dt><dd><code>{{ row.session_id }}</code></dd></div>{% endif %}
            </dl>
            {% if history.kind == 'receipts' %}<p>{{ row.status == 'verified' ? 'Verified stored evidence; hashes establish integrity, not administrator-proof immutability.' : 'Completion attempt is not finalized verified evidence.' }}</p><a href="{{ path('api_observability_receipt', {id:row.id}) }}">Inspect canonical evidence</a>{% endif %}
            {% if history.kind == 'contracts' %}{% for field,label in {authorizedScope:'Authorized scope',constraints:'Constraints',acceptanceCriteria:'Acceptance criteria',expectedDeliverables:'Expected deliverables',dependencies:'Dependencies'} %}{% set values = row.document[field]|default([]) %}<h4>{{ label }}</h4>{% if values is iterable %}<ul>{% for value in values %}<li>{{ value is iterable ? value|json_encode : value }}</li>{% else %}<li>None recorded.</li>{% endfor %}</ul>{% else %}<p>{{ values }}</p>{% endif %}{% endfor %}{% endif %}
            <details data-review-detail="raw-{{ history.kind }}-{{ row.id }}"><summary>Record JSON</summary><pre>{{ row|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details></div>
        </details></li>
    {% else %}<li class="empty-state">No {{ history.kind }} match these filters. Other record types may contain history.</li>{% endfor %}</ol>
    <nav class="pagination" aria-label="Historical record pages"><button type="button" data-review-page="{{ history.page - 1 }}" {{ history.page == 0 ? 'disabled' : '' }}>Previous</button><span>Page {{ history.page + 1 }} · up to {{ history.page_size }} records</span><button type="button" data-review-page="{{ history.page + 1 }}" {{ not history.has_next ? 'disabled' : '' }}>Next</button></nav>
    {% else %}<p class="empty-state">Historical records load when this view opens. <a href="{{ path('app_console_history', {project:project}) }}">Open historical review</a></p>{% endif %}
</div>

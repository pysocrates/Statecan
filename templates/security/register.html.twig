{% extends 'base.html.twig' %}
{% block title %}Create account · Statecan{% endblock %}
{% block body %}
<main><h1>Create an account</h1>
{% if error %}<p role="alert">{{ error }}</p>{% endif %}
<form method="post">
<label>Email <input type="email" name="email" value="{{ email }}" maxlength="180" autocomplete="email" required autofocus></label>
<label>Password <input type="password" name="password" minlength="12" maxlength="4096" autocomplete="new-password" required></label>
<input type="hidden" name="_token" value="{{ csrf_token('register') }}"><button>Create account</button></form>
<p><a href="{{ path('app_login') }}">Sign in</a></p></main>
{% endblock %}

{% extends 'base.html.twig' %}
{% block title %}Sign in · Statecan{% endblock %}
{% block body %}
<main><h1>Sign in</h1>
{% for message in app.flashes('success') %}<p>{{ message }}</p>{% endfor %}
{% if error %}<p role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</p>{% endif %}
<form method="post">
<label>Email <input type="email" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus></label>
<label>Password <input type="password" name="_password" autocomplete="current-password" required></label>
<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button>Sign in</button></form>
<p><a href="{{ path('app_register') }}">Create an account</a></p></main>
{% endblock %}

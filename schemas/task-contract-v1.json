{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:statecan:task-contract:1",
  "title": "Statecan task contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "objective", "authorizedScope", "constraints", "dependencies", "acceptanceCriteria", "expectedDeliverables"],
  "properties": {
    "schemaVersion": {"const": 1},
    "objective": {"type": "string", "minLength": 1},
    "authorizedScope": {"$ref": "#/$defs/stringList"},
    "constraints": {"$ref": "#/$defs/stringList"},
    "dependencies": {"type": "array", "items": {"type": "string", "format": "uuid"}},
    "acceptanceCriteria": {"$ref": "#/$defs/stringList"},
    "expectedDeliverables": {"$ref": "#/$defs/stringList"},
    "resourceBudgets": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}}
  },
  "$defs": {"stringList": {"type": "array", "items": {"type": "string", "minLength": 1}}}
}
